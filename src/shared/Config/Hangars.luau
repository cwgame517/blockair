--!strict
-- 원정 섬 격납고 (임시값). 원본: 기획서 4장 '격납고 4곳', 6장 '수리와 HP 회복'
-- 섬 가장자리 바깥 동서남북에 하나씩. 위의 빛나는 원기둥 안으로 날아 들어가면
-- 화물이 바로 맡겨지고, 안에서 3초 머물면 HP 가 가득 찬다. 착륙은 필요 없다.
return {
	COUNT = 4,
	GAP = 60, -- 섬 가장자리에서 격납고 가운데까지 거리 (스터드)
	PAD_Y = 16, -- 격납고 발판 윗면 높이 (섬 땅 표면 = 0)
	PAD_SIZE = 40, -- 발판 한 변 (스터드)
	ZONE_RADIUS = 32, -- 빛나는 원기둥 반지름 (스터드)
	ZONE_HEIGHT = 70, -- 발판 위로 원기둥 높이 (비행기가 타는 곳 위 40 스터드에 나타나므로 그보다 높게)
	CHECK_INTERVAL = 0.2, -- 구역 안에 있는지 검사하는 간격 (초)
	REPAIR_TIME = 3, -- 이만큼 머물면 수리 완료 (초)
	NO_REPAIR_AFTER_HIT = 5, -- 마지막으로 맞은 뒤 이 시간 안에는 수리가 시작되지 않음 (초)
	ZONE_COLOR = Color3.fromRGB(90, 220, 255),
}
