--!strict
-- 연료 (5단계). 원본: 기획서 4장 '연료', 성장 수치표 '코인 수입' 시트(연료 블록 회복량은 MapBlocks)
-- 원정 섬에서만 줄고 허브에서는 줄지 않는다. 연료 양은 탱크 1 = 100%.
--   탱크: 지금 쓰는 연료. 원정을 시작하면 가득.
--   저장분: 석탄·석유·우라늄을 캐면 쌓이는 연료 (화물칸을 차지하지 않음).
--   탱크가 20% 아래로 내려가면 저장분에서 자동으로 채운다 (묻지 않음).
--   탱크가 0 이면 느린 활공: 속도가 줄고 천천히 내려가지만 추락하지 않는다.
--   격납고 빛나는 구역에 들어가면 최소량(30%)까지 무료로 채워 준다.
return {
	TANK_TIME = 300, -- 기준 무게 비행기가 가득 찬 탱크로 날 수 있는 시간 (초, 약 5분)
	HOVER_BURN = 0.5, -- 제자리 비행(거의 멈춤) 중에는 이만큼만 줄어듦
	HOVER_SPEED = 12, -- 이 속도(스터드/초)보다 느리면 제자리 비행으로 본다

	-- 무게: 칸 1개 평균 무게 ÷ 기준 무게(Flight.REF_WEIGHT_PER_CELL) 의 WEIGHT_EXP 제곱만큼 빨리 줄어든다
	-- 나무(0.4)만 = ×0.7(최소), 돌(1) = ×1, 철(2)만 = ×1.41
	WEIGHT_EXP = 0.5,
	BURN_MUL_MIN = 0.7,
	BURN_MUL_MAX = 1.6,

	AUTO_REFILL_BELOW = 0.2, -- 탱크가 이 아래면 저장분에서 자동 충전
	HANGAR_MIN = 0.3, -- 격납고에서 무료로 채워 주는 최소량
	LOW_WARN = 0.2, -- 이 아래면 연료 막대가 빨개지고 경고

	-- 활공 (연료 0)
	GLIDE_SPEED = 30, -- 활공 속도 (스터드/초)
	GLIDE_SINK = 6, -- 1초에 내려가는 높이 (스터드)
	GLIDE_TURN_MUL = 0.7, -- 활공 중 회전 빠르기 배율

	TICK = 0.5, -- 서버가 연료를 계산하는 간격 (초)
}
